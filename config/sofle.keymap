#include <behaviors.dtsi>
#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NUMPAD 1
#define RAISE 2
#define CORNE 3
#define NAV 4
#define NUM 5
#define FUN 6
#define MOUSE 7
#define SYM 8
#define MFAST 9

/ {
    behaviors {
        td_layer: td_layer {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LAYER";
            #binding-cells = <0>;
            bindings = <&mo RAISE>, <&mo NUMPAD>, <&tog NUMPAD>;
        };

        td_hypers: td_hypers {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_HYPERS";
            #binding-cells = <0>;
            bindings = <&kp LG(LEFT_ALT)>, <&kp LC(LS(LA(LEFT_GUI)))>;
        };

        td_equal_plus_minus: td_equal_plus_minus {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_EQUAL_PLUS_MINUS";
            #binding-cells = <0>;
            bindings = <&kp KP_EQUAL>, <&kp KP_PLUS>, <&kp KP_MINUS>;
        };

        td_alt_to_f17: td_alt_to_f17 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ALT_TO_F17";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT>, <&kp F17>;
        };

        td_tilde_del_space: td_tilde_del_space {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_TILDE_DEL_SPACE";
            #binding-cells = <0>;
            bindings = <&kp LS(GRAVE)>, <&kp GRAVE>, <&kp DELETE>, <&kp SPACE>;
        };

        td_del_space: td_del_space {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_DEL_SPACE";
            #binding-cells = <0>;
            bindings = <&kp DELETE>, <&kp SPACE>;
        };

        td_num_fun: td_num_fun {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_NUM_FUN";
            #binding-cells = <0>;
            bindings = <&tog NUM>, <&tog FUN>;
        };

        lt_nav: lt_nav {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_NAV";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        ht_sym: ht_sym {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_SYM";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&td_num_fun>;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49 55 56 57 58 59>;
            bindings = <&kp>, <&kp>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53 54>;
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        select_all: select_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(A)>;
            label = "SELECT_ALL";
        };

        copy_word: copy_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LEFT) &kp LC(LS(RIGHT)) &kp LC(C)>;
            label = "COPY_WORD";
        };

        replace_word: replace_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LEFT) &kp LC(LS(RIGHT)) &kp LC(V)>;
            label = "REPLACE_WORD";
        };

        bt_1_and_back_to_layer: bt_1_and_back_to_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F13 &bt BT_SEL 0 &tog NUMPAD>;
            label = "BT_1_AND_BACK_TO_LAYER";
        };

        bt_2_and_back_to_layer: bt_2_and_back_to_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F13 &bt BT_SEL 1 &tog NUMPAD>;
            label = "BT_2_AND_BACK_TO_LAYER";
        };
    };

    combos {
        compatible = "zmk,combos";

        db_del_space {
            bindings = <&td_del_space>;
            key-positions = <0 1>;
        };

        studio_unlock {
            bindings = <&studio_unlock>;
            key-positions = <42 43>;
            timeout-ms = <60>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&td_tilde_del_space  &kp N1  &kp N2      &kp N3          &kp N4     &kp N5                                                      &kp N6     &kp N7     &kp N8     &kp N9    &kp N0    &kp MINUS
&kp ESC              &kp Q   &kp W       &kp E           &kp R      &kp T                                                       &kp Y      &kp U      &kp I      &kp O     &kp P     &kp BSPC
&kp TAB              &kp A   &kp S       &kp D           &kp F      &kp G                                                       &kp H      &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT            &kp Z   &kp X       &kp C           &kp V      &kp B         &kp C_MUTE        &kp C_PP                   &kp N      &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                             &td_hypers  &td_alt_to_f17  &kp LCTRL  &kp LEFT_GUI  &kp RET             &kp SPACE                 &td_layer  &kp RCTRL  &kp RALT   &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_NEXT C_PREV>;

            label = "base";
        };

        numpad {
            display-name = "numpad";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&bt BT_CLR  &bt_1_and_back_to_layer  &bt_2_and_back_to_layer  &bt BT_SEL 2  &bt BT_SEL 3       &bt BT_SEL 4                    &kp KP_NUMLOCK  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp KP_MINUS  &kp BSPC
&to CORNE       &trans                   &trans                   &trans        &ext_power EP_TOG  &trans                          &kp SPACE       &kp KP_N7     &kp KP_N8      &kp KP_N9        &kp DEL       &trans
&trans      &trans                   &trans                   &trans        &trans             &trans                          &kp KP_PLUS     &kp KP_N4     &kp KP_N5      &kp KP_N6        &kp KP_EQUAL  &trans
&trans      &trans                   &trans                   &trans        &trans             &trans        &trans    &trans  &trans          &kp KP_N1     &kp KP_N2      &kp KP_N3        &kp KP_ENTER  &tog NUMPAD
                                     &trans                   &trans        &trans             &trans        &trans    &trans  &mo RAISE           &kp KP_N0     &kp KP_DOT     &kp COMMA
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_NEXT C_PREV>;

            label = "numpad";
        };

        raise {
            display-name = "raise";
            bindings = <
&kp F12  &kp F1       &kp F2      &kp F3         &kp F4           &kp F5                             &kp F6            &kp F7             &kp F8    &kp F9     &kp F10        &kp F11
&trans   &trans       &trans      &kp K_CMENU    &kp PRINTSCREEN  &kp C_AC_SEARCH                    &kp PG_UP         &kp HOME           &kp UP    &kp END    &kp BACKSPACE  &kp DELETE
&trans   &select_all  &copy_word  &replace_word  &trans           &kp CLCK                           &kp PG_DN         &kp LEFT           &kp DOWN  &kp RIGHT  &kp BACKSLASH  &td_equal_plus_minus
&trans   &kp K_UNDO   &kp K_CUT   &kp K_COPY     &kp K_PASTE      &kp INSERT       &trans    &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans    &trans     &trans         &tog NUMPAD
                      &trans      &trans         &trans           &trans           &trans    &trans  &trans            &trans             &trans    &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_NEXT C_PREV>;

            label = "raise";
        };

        corne {
            display-name = "corne";

            bindings = <
&to BASE  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &hml LGUI A  &hml LALT S  &hml LCTRL D  &hml LSHFT F  &trans  &trans  &hmr LSHFT J  &hmr LCTRL K  &hmr LALT L  &hmr LGUI SEMI  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&none  &none  &lt MOUSE TAB  &lt_nav NAV F17  &lt NUM ENTER  &kp SPACE  &ht_sym SYM 0  &kp BKSP  &none  &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_NEXT C_PREV>;

            label = "corne";
        };

        nav {
            display-name = "nav";

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &select_all  &copy_word  &replace_word  &trans  &trans  &kp PG_UP  &kp HOME  &kp UP  &kp END  &kp BACKSPACE  &kp DELETE
&trans  &trans  &trans  &trans  &trans  &trans  &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
&trans  &kp K_UNDO  &kp K_CUT  &kp K_COPY  &kp K_PASTE  &trans  &trans  &trans  &trans  &kp LA(LEFT)  &trans  &kp LA(RIGHT)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LA(BSPC)  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_NEXT C_PREV>;

            label = "nav";
        };

        num {
            display-name = "num";

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_ENTER  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_N0  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_NEXT C_PREV>;

            label = "num";
        };

        fun {
            display-name = "fun";

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp F12  &kp F7  &kp F8  &kp F9  &kp PSCRN  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp F11  &kp F4  &kp F5  &kp F6  &kp SLCK  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_NEXT C_PREV>;

            label = "fun";
        };

        mouse {
            display-name = "mouse";

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &msc SCRL_UP  &msc SCRL_LEFT  &mmv MOVE_UP  &msc SCRL_RIGHT  &trans  &trans
&trans  &mkp MB1  &mkp MB2  &mkp MB3  &mo MFAST  &trans  &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_NEXT C_PREV>;

            label = "mouse";
        };

        sym {
            display-name = "sym";

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LBRC  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RBRC  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp COLON  &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS  &trans  &trans  &trans  &trans  &trans  &td_equal_plus_minus
&trans  &kp TILDE  &kp EXCL  &kp AT  &kp HASH  &kp PIPE  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_NEXT C_PREV>;

            label = "sym";
        };

        mouse_fast {
            display-name = "mouse_fast";

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &msc SCRL_UP  &msc SCRL_LEFT  &mmv MOVE(0, -1800)  &msc SCRL_RIGHT  &trans  &trans
&trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans  &msc SCRL_DOWN  &mmv MOVE(-1800, 0)  &mmv MOVE(0, 1800)  &mmv MOVE(1800, 0)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_NEXT C_PREV>;

            label = "mouse_fast";
        };
    };
};
